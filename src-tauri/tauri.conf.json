{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiuPlayer",
  "version": "0.1.0",
  "identifier": "com.tagecode.biuplayer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "博音 BiuPlayer",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
