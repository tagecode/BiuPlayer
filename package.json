{
  "name": "biuplayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:native": "node scripts/native-e2e.mjs",
    "test:perf": "pnpm build && playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.4",
    "vitest": "^5.1.2"
  },
  "license": "MIT"
}
